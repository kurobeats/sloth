<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded widget card in the "panda" scheme's background colour. RemoteViews
     cannot tint a drawable before Android 12, so the body colour is baked per
     scheme; the header bar is a plain rectangle and stays dynamic. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="22dp" />
    <solid android:color="#FF1D1E20" />
</shape>
