<?xml version="1.0" encoding="utf-8"?>
<!-- Accent header bar, rounded only on the two top corners so it sits flush in
     the "everforest" card. RemoteViews cannot tint a shape before Android 12. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners
        android:topLeftRadius="22dp"
        android:topRightRadius="22dp" />
    <solid android:color="#FF3A94C5" />
</shape>
