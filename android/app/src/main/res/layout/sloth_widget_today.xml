<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded card: the FrameLayout holds the rounded outline and clips the
     tinted card inside it, because RemoteViews cannot tint a drawable on older
     Android versions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/sloth_widget_card_mocha">

        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FF2A2A2A"
            android:paddingStart="14dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#FFFFFFFF"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Due Today" />

            <TextView
                android:id="@+id/widget_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textSize="13sp"
                android:textColor="#FFB0B0B0"
                android:text="" />

            <!-- Google Calendar puts its add button at the end of the widget
                 header: a pill holding the plus, level with the title. Same
                 sizes as theirs - 52x32dp pill, 48dp touch target - but the
                 pill uses the card colour so it stands out from the accent
                 header, and its corner radius clamps to a stadium shape. -->
            <FrameLayout
                android:id="@+id/widget_add"
                android:layout_width="52dp"
                android:layout_height="48dp"
                android:layout_marginStart="2dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/widget_add_task">

                <FrameLayout
                    android:id="@+id/widget_add_pill"
                    android:layout_width="52dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:background="@drawable/sloth_widget_card_mocha"
                    android:importantForAccessibility="no">

                    <ImageView
                        android:id="@+id/widget_add_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/sloth_widget_add"
                        android:importantForAccessibility="no" />
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="4dp" />

        <TextView
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#FFB0B0B0"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:visibility="gone"
            android:text="Nothing due today" />
</LinearLayout>
